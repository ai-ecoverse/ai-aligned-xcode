# ---------------------------------------------------------------- detection cache
#
# ami_detect's process-tree walk costs ~54ms — 8x a real xcrun call. The answer
# is stable for the life of a session, so memoise it against the session's
# ancestry rather than paying it per invocation.

aax_session_key() {
    local pid=$PPID depth=0 chain=""
    while [ -n "$pid" ] && [ "$pid" -gt 1 ] && [ "$depth" -lt 8 ]; do
        chain="$chain:$pid"
        pid=$(ps -p "$pid" -o ppid= 2>/dev/null | tr -d ' ')
        depth=$((depth + 1))
    done
    echo "${chain#:}" | tr -d ' /' | cksum | cut -d' ' -f1
}

aax_agent() {
    local key cache
    # Honour the opt-out before consulting the cache, or a memoised "claude"
    # would outlive an explicit AMI_PASSTHROUGH.
    if [ "${AMI_PASSTHROUGH:-}" = "true" ]; then
        printf 'none'
        return 0
    fi
    key=$(aax_session_key)
    cache="$AAX_CACHE/agent-$key"
    if [ -r "$cache" ]; then
        cat "$cache"
        return 0
    fi
    local agent
    agent=$(ami_detect 2>/dev/null || echo none)
    mkdir -p "$AAX_CACHE" 2>/dev/null
    printf '%s' "$agent" > "$cache" 2>/dev/null
    printf '%s' "$agent"
}

# ---------------------------------------------------------------- real tool lookup

# Resolve the genuine binary, skipping any directory containing our shim.
aax_real_tool() {
    local name="$1" self_dir candidate
    self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

    case "$name" in
        xcodebuild|xcrun|xcode-select) echo "/usr/bin/$name"; return 0 ;;
    esac

    local IFS=:
    for candidate in $PATH; do
        [ -z "$candidate" ] && continue
        [ "$(cd "$candidate" 2>/dev/null && pwd)" = "$self_dir" ] && continue
        if [ -x "$candidate/$name" ] && [ ! -L "$candidate/$name" ]; then
            echo "$candidate/$name"; return 0
        fi
        if [ -x "$candidate/$name" ]; then
            local target
            target="$(readlink "$candidate/$name")"
            case "$target" in
                *ai-aligned-xcode*) continue ;;
                *) echo "$candidate/$name"; return 0 ;;
            esac
        fi
    done
    return 1
}

# ---------------------------------------------------------------- sqlite store

aax_db_init() {
    mkdir -p "$AAX_HOME" 2>/dev/null
    # Idempotent, and deliberately not guarded on the file existing: any query
    # creates an empty database file, so file presence does not imply a schema.
    # stdout is discarded because "PRAGMA journal_mode" echoes "wal", which
    # would otherwise land in the wrapped tool's output.
    /usr/bin/sqlite3 "$AAX_DB" >/dev/null 2>&1 <<'SQL'
PRAGMA journal_mode=WAL;
CREATE TABLE IF NOT EXISTS runs (
  id            INTEGER PRIMARY KEY,
  ts            INTEGER NOT NULL,
  agent         TEXT    NOT NULL,
  repo          TEXT    NOT NULL,
  worktree      TEXT    NOT NULL,
  tool          TEXT    NOT NULL,
  action        TEXT    NOT NULL,
  scheme        TEXT,
  dest_kind     TEXT,
  udid          TEXT,
  gkey          TEXT    NOT NULL,
  duration_ms   INTEGER,
  lease_wait_ms INTEGER,
  exit_code     INTEGER,
  outcome       TEXT
);
CREATE INDEX IF NOT EXISTS runs_gkey ON runs(gkey, ts);
SQL
    # Additive migrations for databases created by an earlier version. ALTER
    # fails harmlessly once the column is present.
    /usr/bin/sqlite3 "$AAX_DB" >/dev/null 2>&1 \
        "ALTER TABLE runs ADD COLUMN failure_class TEXT;"
    /usr/bin/sqlite3 "$AAX_DB" >/dev/null 2>&1 \
        "ALTER TABLE runs ADD COLUMN retried INTEGER DEFAULT 0;"
    /usr/bin/sqlite3 "$AAX_DB" >/dev/null 2>&1 <<'SQL'
CREATE TABLE IF NOT EXISTS devices (
  udid           TEXT PRIMARY KEY,
  base_name      TEXT NOT NULL,
  owner          TEXT NOT NULL,
  created_by_aax INTEGER DEFAULT 0,
  claimed_at     INTEGER
);
SQL
    # The owning worktree's absolute path. A label alone cannot be resolved
    # back to a directory — "icon-race" could live under .yolo, under
    # intent/workspaces, or nowhere — so record it when we claim.
    /usr/bin/sqlite3 "$AAX_DB" >/dev/null 2>&1 \
        "ALTER TABLE devices ADD COLUMN worktree_path TEXT;"
}

# ---------------------------------------------------------------- failure classes
#
# Separates "the environment broke before your code ran" from "your code is
# wrong". Only the former is worth retrying: 31.9% of observed `xcodebuild test`
# invocations failed, and a meaningful share never reached a single assertion.
#
# The infrastructure signatures come from slicc's swift-coverage-runner-retry.sh
# (which converged on the first three independently) and XCSteward's failure
# taxonomy. Deliberately absent: the generic "Failed to install or launch the
# test runner" wrapper, which also wraps permanent failures such as a bad bundle
# or a bad signature — retrying those just burns another full build.

AAX_RE_RUNNER_INIT='failed to initialize for UI testing|Timed out while loading Accessibility|Application failed preflight checks'
AAX_RE_SIM_BOOT='Unable to boot the Simulator|Unable to boot device in current state|launchd failed to respond|Failed to start launchd_sim|Timed out waiting for the simulator'
AAX_RE_RUNNER_CRASH='Lost connection to the test manager|early unexpected exit|Restarting after unexpected exit|Failed to load the test bundle|test runner never began'
AAX_RE_CORESIM='CoreSimulatorService|Unable to lookup in current state|The service is invalid'
AAX_RE_BUILD_DB='database is locked|unable to attach DB|Build service could not start'

AAX_RE_TEST_FAIL='\*\* TEST FAILED \*\*|Testing failed:'
AAX_RE_BUILD_FAIL='\*\* BUILD FAILED \*\*|The following build commands failed'
AAX_RE_SIGNING='requires a development team|Command CodeSign failed|No profiles for|no valid signing identit'
AAX_RE_DEST='Unable to find a device matching|Unable to find a destination matching|ineligible destinations|Invalid device'

# Echo a class name for a run's captured output. Empty when nothing matched.
aax_classify() {
    local log="$1"
    [ -s "$log" ] || return 0
    if   grep -qE "$AAX_RE_RUNNER_INIT"  "$log" 2>/dev/null; then echo runner_bootstrap
    elif grep -qE "$AAX_RE_SIM_BOOT"     "$log" 2>/dev/null; then echo sim_boot
    elif grep -qE "$AAX_RE_RUNNER_CRASH" "$log" 2>/dev/null; then echo runner_crash
    elif grep -qE "$AAX_RE_CORESIM"      "$log" 2>/dev/null; then echo coresim
    elif grep -qE "$AAX_RE_BUILD_DB"     "$log" 2>/dev/null; then echo build_db_lock
    elif grep -qE "$AAX_RE_SIGNING"      "$log" 2>/dev/null; then echo signing
    elif grep -qE "$AAX_RE_DEST"         "$log" 2>/dev/null; then echo destination
    elif grep -qE "$AAX_RE_TEST_FAIL"    "$log" 2>/dev/null; then echo test_failure
    elif grep -qE "$AAX_RE_BUILD_FAIL"   "$log" 2>/dev/null; then echo build_failure
    fi
}

# Is this class an environment failure that a second attempt could clear?
aax_is_retryable() {
    case "$1" in
        runner_bootstrap|sim_boot|runner_crash|coresim|build_db_lock) return 0 ;;
        *) return 1 ;;
    esac
}

aax_sql() {
    # .timeout rather than "PRAGMA busy_timeout" — the pragma echoes its value
    # onto stdout, which would corrupt the wrapped tool's output.
    /usr/bin/sqlite3 -cmd ".timeout 5000" "$AAX_DB" "$@" 2>/dev/null
}

# Median duration for a grouping key over its most recent samples.
# Echoes milliseconds, or nothing when there is not enough history.
aax_predict() {
    local gkey="$1" esc
    esc=${gkey//\'/\'\'}
    aax_sql "
WITH recent AS (
  SELECT duration_ms FROM runs
   WHERE gkey='$esc' AND duration_ms IS NOT NULL
     AND outcome IN ('ok','fail')
   ORDER BY ts DESC LIMIT 20
), ranked AS (
  SELECT duration_ms,
         ROW_NUMBER() OVER (ORDER BY duration_ms) rn,
         COUNT(*)     OVER ()                     n
    FROM recent
)
SELECT CASE WHEN n >= $AAX_MIN_SAMPLES
            THEN MAX(CASE WHEN rn = (n+1)/2 THEN duration_ms END)
       END
  FROM ranked;"
}

aax_record() {
    local agent="$1" repo="$2" worktree="$3" tool="$4" action="$5" scheme="$6"
    local dest_kind="$7" udid="$8" gkey="$9" dur="${10}" wait_ms="${11}"
    local rc="${12}" outcome="${13}"
    local fclass="${AAX_FAILURE_CLASS:-}" retried="${AAX_RETRIED:-0}"
    local q
    q="INSERT INTO runs
      (ts,agent,repo,worktree,tool,action,scheme,dest_kind,udid,gkey,
       duration_ms,lease_wait_ms,exit_code,outcome,failure_class,retried)
      VALUES ($(date +%s),'${agent//\'/\'\'}','${repo//\'/\'\'}',
              '${worktree//\'/\'\'}','${tool//\'/\'\'}','${action//\'/\'\'}',
              '${scheme//\'/\'\'}','${dest_kind//\'/\'\'}','${udid//\'/\'\'}',
              '${gkey//\'/\'\'}',$dur,$wait_ms,$rc,'${outcome//\'/\'\'}',
              '${fclass//\'/\'\'}',$retried);"
    aax_sql "$q"
}

# ---------------------------------------------------------------- argv parsing

AAX_ACTION="" AAX_SCHEME="" AAX_DEST="" AAX_DDP="" AAX_PROJECT="" AAX_NO_LEASE=0

aax_parse_xcodebuild() {
    local prev="" a
    for a in "$@"; do
        # Reports build settings without running a build: needs the same
        # DerivedData for path consistency, but must not hold the device.
        [ "$a" = "-showBuildSettings" ] && AAX_NO_LEASE=1
        case "$prev" in
            -scheme)          AAX_SCHEME="$a" ;;
            -destination)     AAX_DEST="$a" ;;
            -derivedDataPath) AAX_DDP="$a" ;;
            -project|-workspace) AAX_PROJECT="$a" ;;
        esac
        case "$a" in
            build|test|archive|clean|analyze|install|build-for-testing|\
            test-without-building|docbuild)
                [ -z "$AAX_ACTION" ] && AAX_ACTION="$a" ;;
        esac
        prev="$a"
    done
    [ -z "$AAX_ACTION" ] && AAX_ACTION="build"
}

# Classify -destination into sim / generic / device / none, and resolve a UDID.
AAX_DEST_KIND="none" AAX_UDID=""

aax_resolve_destination() {
    local dest="$1"
    if [ -z "$dest" ]; then AAX_DEST_KIND="none"; return 0; fi
    case "$dest" in
        generic/*) AAX_DEST_KIND="generic"; return 0 ;;
    esac
    case "$dest" in
        *id=*)
            AAX_UDID=$(echo "$dest" | sed -n 's/.*id=\([0-9A-Fa-f-]\{36\}\).*/\1/p')
            if [ -n "$AAX_UDID" ]; then AAX_DEST_KIND="sim"; return 0; fi
            # A non-UUID id= is a physical device ECID.
            AAX_DEST_KIND="device"; return 0 ;;
    esac
    case "$dest" in
        *"iOS Simulator"*|*"watchOS Simulator"*|*"tvOS Simulator"*|*"visionOS Simulator"*)
            AAX_DEST_KIND="sim"
            AAX_UDID=$(aax_resolve_name_to_udid "$dest")
            return 0 ;;
        *platform=macOS*|*platform=OS\ X*) AAX_DEST_KIND="none"; return 0 ;;
    esac
    AAX_DEST_KIND="device"
}

# Map a name=/OS= destination onto a concrete UDID.
#
# simctl's JSON dict order is unspecified, so sort runtimes by version rather
# than taking the first — an older runtime can fail at launch on a missing
# libswiftWebKit.dylib. (Learned the hard way in slicc's docs/ios-simulator-qa.md.)
aax_resolve_name_to_udid() {
    local dest="$1" name
    name=$(echo "$dest" | sed -n 's/.*name=\([^,]*\).*/\1/p')
    [ -z "$name" ] && return 0
    command -v jq >/dev/null 2>&1 || return 0
    AI_ALIGNED_XCODE_ACTIVE=1 /usr/bin/xcrun simctl list devices available --json 2>/dev/null \
      | jq -r --arg n "$name" '
          [ .devices | to_entries[]
            | select(.key | test("SimRuntime"))
            | { ver: (.key | capture("-(?<v>[0-9]+(-[0-9]+)*)$").v
                          | split("-") | map(tonumber)),
                devs: [ .value[] | select(.isAvailable and .name == $n) ] }
            | select(.devs | length > 0) ]
          | sort_by(.ver) | last | .devs | first | .udid // empty' 2>/dev/null
}

# ---------------------------------------------------------------- worktree identity

aax_repo_root() {
    git rev-parse --show-toplevel 2>/dev/null || pwd
}

aax_worktree_slug() {
    local root="$1"
    printf '%s' "$root" | tr -d ' ' | cksum | cut -d' ' -f1
}

# ---------------------------------------------------------------- device ownership
#
# A device is owned by exactly one worktree, and ownership is written into the
# device NAME as a "[label]" suffix. simctl offers no metadata field, and the
# name is the only channel that survives a reboot, shows up in Simulator.app,
# and is visible to anyone running `simctl list` — including agents that never
# talk to this tool. SQLite mirrors it, but the name is the source of truth.
#
# Renaming is metadata-only: UDIDs are stable, so tagging a device a build is
# already using cannot disturb that build.

# Human-readable, stable identifier for the current worktree. The repo basename
# is not enough: every intent workspace checks out to <workspace>/slicc, so all
# of them would collide on "slicc".
aax_worktree_label() {
    local root="$1" label
    case "$root" in
        *"/.yolo/"*)              label="${root##*/.yolo/}" ;;
        *"/.claude-worktrees/"*)  label="${root##*/.claude-worktrees/}" ;;
        *"/intent/workspaces/"*)  label="${root##*/intent/workspaces/}" ;;
        *)                        label="$(basename "$root")" ;;
    esac
    label="${label%%/*}"
    # Keep it safe for a device name and for our own parsing.
    label=$(printf '%s' "$label" | tr -c 'A-Za-z0-9._-' '-' | cut -c1-24)
    printf '%s' "${label:-unknown}"
}

# Split "iPhone 17 Pro [two-check-2]" into base name and owner tag.
aax_device_base() { printf '%s' "${1% \[*\]}"; }
aax_device_tag() {
    case "$1" in
        *" ["*"]") local t="${1##* \[}"; printf '%s' "${t%\]}" ;;
        *) printf '' ;;
    esac
}

# Echo "name<TAB>state<TAB>deviceTypeIdentifier<TAB>runtimeKey" for a UDID.
aax_device_info() {
    AI_ALIGNED_XCODE_ACTIVE=1 /usr/bin/xcrun simctl list devices --json 2>/dev/null \
      | jq -r --arg u "$1" '
          .devices | to_entries[] | .key as $rt | .value[]
          | select(.udid == $u)
          | [.name, .state, .deviceTypeIdentifier, $rt] | @tsv' 2>/dev/null | head -1
}

# Rename a device to carry an owner tag, and remember it.
aax_claim_device() {
    local udid="$1" base="$2" label="$3" created="${4:-0}"
    AI_ALIGNED_XCODE_ACTIVE=1 /usr/bin/xcrun simctl rename "$udid" "$base [$label]" 2>/dev/null || return 1
    local wt; wt=$(aax_repo_root)
    aax_sql "INSERT OR REPLACE INTO devices
               (udid,base_name,owner,created_by_aax,claimed_at,worktree_path)
             VALUES('${udid//\'/\'\'}','${base//\'/\'\'}','${label//\'/\'\'}',$created,
                    $(date +%s),'${wt//\'/\'\'}');"
    return 0
}

# Find (or make) this worktree's device of a given type+runtime. Echoes a UDID.
# Assign a free stock device first; clone only once the pool is exhausted.
aax_device_for() {
    local dtype="$1" runtime="$2" label="$3" udid base

    # Already ours?
    udid=$(AI_ALIGNED_XCODE_ACTIVE=1 /usr/bin/xcrun simctl list devices --json 2>/dev/null \
      | jq -r --arg t "$dtype" --arg r "$runtime" --arg l " [$label]" '
          .devices[$r][]? | select(.isAvailable and .deviceTypeIdentifier==$t
                                   and (.name | endswith($l))) | .udid' 2>/dev/null | head -1)
    [ -n "$udid" ] && { printf '%s' "$udid"; return 0; }

    # A free, untagged one of the same type+runtime.
    #
    # Never take a Booted device: something is using it right now, and grabbing
    # it is the interference this whole tool exists to stop. Prefer stock
    # product names too — a device called "fix-1916-browser" was made
    # deliberately for a piece of work and is not spare capacity.
    udid=$(AI_ALIGNED_XCODE_ACTIVE=1 /usr/bin/xcrun simctl list devices --json 2>/dev/null \
      | jq -r --arg t "$dtype" --arg r "$runtime" '
          [ .devices[$r][]?
            | select(.isAvailable and .deviceTypeIdentifier==$t
                     and .state == "Shutdown"
                     and (.name | test("\\[[^]]+\\]$") | not)) ]
          | sort_by(.name | test("^(iPhone|iPad|Apple) ") | not)
          | .[0].udid // empty' 2>/dev/null | head -1)
    if [ -n "$udid" ]; then
        base=$(aax_device_base "$(aax_device_info "$udid" | cut -f1)")
        aax_claim_device "$udid" "$base" "$label" 0 && { printf '%s' "$udid"; return 0; }
    fi

    # Pool exhausted for this type+runtime: make a new one. `reap` cleans these
    # up. simctl create, not clone — clone refuses a Booted source, and the one
    # remaining device of a contended type is very often the booted one. A
    # fresh device is also cleaner than a copy of someone else's state.
    # Name it after a stock sibling, not whatever sorts first — a custom device
    # like "fix-1916-browser" must not become the template for the whole type.
    base=$(AI_ALIGNED_XCODE_ACTIVE=1 /usr/bin/xcrun simctl list devices --json 2>/dev/null \
      | jq -r --arg t "$dtype" --arg r "$runtime" '
          [ .devices[$r][]? | select(.deviceTypeIdentifier==$t)
            | (.name | sub(" \\[[^]]+\\]$"; "")) ]
          | (map(select(test("^(iPhone|iPad|Apple) "))) + .) | .[0] // empty' 2>/dev/null)
    base=$(aax_device_base "${base:-device}")
    udid=$(AI_ALIGNED_XCODE_ACTIVE=1 /usr/bin/xcrun simctl create "$base [$label]" \
             "$dtype" "$runtime" 2>/dev/null | tr -d '[:space:]')
    [ -z "$udid" ] && return 1
    local wt; wt=$(aax_repo_root)
    aax_sql "INSERT OR REPLACE INTO devices
               (udid,base_name,owner,created_by_aax,claimed_at,worktree_path)
             VALUES('${udid//\'/\'\'}','${base//\'/\'\'}','${label//\'/\'\'}',1,
                    $(date +%s),'${wt//\'/\'\'}');"
    aax_notice "simulator pool exhausted for this device type; created $base [$label] = $udid"
    printf '%s' "$udid"
}

# Enforce ownership for a resolved UDID. Returns non-zero (callers exit 78) and
# prints guidance when the device belongs to another worktree.
aax_check_ownership() {
    local udid="$1" label="$2" info name tag base mine dtype runtime

    [ "${AI_ALIGNED_XCODE_NO_OWNERSHIP:-false}" = "true" ] && return 0
    command -v jq >/dev/null 2>&1 || return 0

    info=$(aax_device_info "$udid")
    [ -z "$info" ] && return 0
    name=$(printf '%s' "$info" | cut -f1)
    dtype=$(printf '%s' "$info" | cut -f3)
    runtime=$(printf '%s' "$info" | cut -f4)
    tag=$(aax_device_tag "$name")
    base=$(aax_device_base "$name")

    # Ours already.
    [ "$tag" = "$label" ] && return 0

    # Unowned: claim it on first use. Without this, everyone keeps sharing the
    # one device that got copied between sessions and ownership never forms.
    if [ -z "$tag" ]; then
        aax_claim_device "$udid" "$base" "$label" 0 \
            && aax_notice "claimed $base ($udid) for worktree '$label'"
        return 0
    fi

    # Owned by someone else. Work out what this worktree should use instead,
    # so the refusal comes with an answer rather than just a No.
    mine=$(aax_device_for "$dtype" "$runtime" "$label")
    cat >&2 <<EOF
ai-aligned-xcode: refusing to use $udid.

  device : $base
  owner  : worktree '$tag'
  you    : worktree '$label'
EOF
    if [ -n "$mine" ]; then
        # The assigned device's own name — not the denied device's. They differ
        # whenever the pool hands over a different unit of the same type.
        local mine_name; mine_name=$(aax_device_info "$mine" | cut -f1)
        echo "  yours  : ${mine_name:-$base [$label]} = $mine" >&2
        echo "" >&2
        echo "Re-run against your own device:" >&2
        echo "  -destination 'platform=iOS Simulator,id=$mine'" >&2
    else
        echo "" >&2
        echo "No free device of this type could be assigned to you." >&2
    fi
    echo "" >&2
    echo "Set AI_ALIGNED_XCODE_NO_OWNERSHIP=true to bypass this check." >&2
    return 1
}

# ---------------------------------------------------------------- lock ordering
#
# A build can need two leases: the DerivedData tree it writes, and the simulator
# it drives. Two locks admit deadlock, so there is one global rule:
#
#     ALWAYS acquire the DerivedData lease (fd 8) before the simulator (fd 9).
#
# xcodegen takes only fd 8; `xcrun simctl` takes only fd 9; xcodebuild takes 8
# then 9. No cycle can form.
#
# DerivedData is the right key rather than the project path: two builds sharing
# a tree corrupt each other whatever project they name, and regenerating the
# project invalidates that same tree. 38 pairs of concurrent builds in one
# worktree were observed in the corpus.

aax_dd_lock_file() {
    local dd="$1" h
    h=$(printf '%s' "$dd" | tr -d ' ' | cksum | cut -d' ' -f1)
    printf '%s/dd-%s.lock' "$AAX_LEASES" "$h"
}

# "3d" / "12h" / "90m" / "45s" / bare seconds -> seconds. Non-zero on garbage.
aax_duration_seconds() {
    local v="$1" n u
    n="${v%[dhms]}"; u="${v#"$n"}"
    case "$n" in ''|*[!0-9]*) return 1 ;; esac
    case "$u" in
        d) echo $((n * 86400)) ;;
        h) echo $((n * 3600)) ;;
        m) echo $((n * 60)) ;;
        s|'') echo "$n" ;;
        *) return 1 ;;
    esac
}

# Does the worktree that owns <label> still exist?
#
# The recorded path is authoritative. For devices claimed before that column
# existed — or tagged by hand — fall back to searching the places worktrees
# actually live. A label on its own is not resolvable: "icon-race" could be a
# .yolo worktree, an intent workspace, or long gone.
#
# Echoes the path when found; returns 1 when the worktree is gone.
aax_worktree_exists() {
    local label="$1" recorded="$2" c
    if [ -n "$recorded" ]; then
        [ -d "$recorded" ] && { printf '%s' "$recorded"; return 0; }
        return 1
    fi
    for c in "$HOME/intent/workspaces/$label" \
             "$HOME/Developer/ai-ecoverse/$label" \
             "$HOME/Developer/$label" \
             "/tmp/$label" "/private/tmp/$label"; do
        [ -d "$c" ] && { printf '%s' "$c"; return 0; }
    done
    # Worktrees nested under a repo: <repo>/.yolo/<label>, .claude-worktrees/<label>
    for c in "$HOME"/Developer/*/.yolo/"$label" \
             "$HOME"/Developer/*/*/.yolo/"$label" \
             "$HOME"/Developer/*/.claude-worktrees/"$label" \
             "$HOME"/Developer/*/*/.claude-worktrees/"$label"; do
        [ -d "$c" ] && { printf '%s' "$c"; return 0; }
    done
    return 1
}

# True when <lockfile> exists and someone holds it.
aax_lease_held() {
    [ -e "$1" ] || return 1
    python3 -c '
import fcntl, sys
try:
    fcntl.flock(open(sys.argv[1], "a"), fcntl.LOCK_EX | fcntl.LOCK_NB)
except OSError:
    sys.exit(0)   # held by someone else
sys.exit(1)       # free
' "$1" 2>/dev/null
}

AAX_LEASE_FAILED=0
AAX_LEASE_WAIT_MS=0

# flock(2) on an already-open fd. <timeout> 0 means try-once, non-blocking.
#
# NOT lockf(1): macOS lockf BUSY-WAITS, burning a full core for the whole wait,
# with or without -t. Fourteen waiters took this machine to 0.18% idle. Python's
# fcntl.flock is a real blocking lock — measured at 0.02s of CPU for a 9.5s
# wait — and SIGALRM gives the timeout without polling.
aax_flock() {
    local fd="$1" timeout="$2"
    python3 -c '
import fcntl, signal, sys
fd, timeout = int(sys.argv[1]), float(sys.argv[2])
if timeout <= 0:
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        sys.exit(1)
    sys.exit(0)
def expire(_sig, _frm):
    sys.exit(1)
signal.signal(signal.SIGALRM, expire)
signal.setitimer(signal.ITIMER_REAL, timeout)
try:
    fcntl.flock(fd, fcntl.LOCK_EX)
except (OSError, InterruptedError):
    sys.exit(1)
signal.setitimer(signal.ITIMER_REAL, 0)
' "$fd" "$timeout" 2>/dev/null
}

# Acquire a lease on <fd> over <file>, blocking in this process.
#
# The lock is held by THIS shell: the helper exits immediately once acquired,
# but the flock(2) lives on the open file description, which our fd keeps alive
# until we close it. Holding it here (rather than re-exec'ing the payload under
# a locking wrapper) keeps the watchdog and the timing in the same process, and
# means the agent's single tool call absorbs the wait. Returning "busy, retry
# later" instead is what produced the poll loops this tool exists to remove.
aax_take_lease() {
    local fd="$1" file="$2" busy_msg="$3" t0

    # Fixed fds rather than eval: only 8 and 9 are ever used, in that order.
    case "$fd" in
        8) exec 8>>"$file" ;;
        9) exec 9>>"$file" ;;
        *) return 1 ;;
    esac

    aax_flock "$fd" 0 && return 0

    aax_notice "$busy_msg; waiting (up to ${AAX_LEASE_WAIT}s)"
    t0=$(date +%s)
    if ! aax_flock "$fd" "$AAX_LEASE_WAIT"; then
        aax_notice "gave up waiting after ${AAX_LEASE_WAIT}s"
        AAX_LEASE_FAILED=1
    fi
    AAX_LEASE_WAIT_MS=$(( AAX_LEASE_WAIT_MS + ($(date +%s) - t0) * 1000 ))
    [ "$AAX_LEASE_FAILED" = "0" ]
}

# ---------------------------------------------------------------- execution

# Run a command under an optional watchdog. macOS ships no timeout(1), so this
# forks a killer rather than depending on GNU coreutils being present.
AAX_TIMED_OUT=0

# When AAX_LOG is set, both streams are mirrored into it for classification.
# Process substitution keeps stdout on stdout and stderr on stderr: merging them
# would corrupt callers that parse the two separately.
AAX_LOG=""

aax_run() {
    local budget="$1"; shift
    local rc=0 cmd_pid dog_pid
    AAX_TIMED_OUT=0

    if [ "$budget" -le 0 ]; then
        if [ -n "$AAX_LOG" ]; then
            "$@" > >(tee -a "$AAX_LOG") 2> >(tee -a "$AAX_LOG" >&2)
            rc=$?
            wait          # let the tee subshells drain before we read the log
            return $rc
        fi
        "$@"
        return $?
    fi

    local marker
    marker=$(mktemp -t ai-aligned-xcode-dog) || return 1

    # 9>&- closes the inherited lease descriptor in both children. An flock is
    # released only when every fd on the open file description is closed, so a
    # watchdog that outlives the build (it sleeps through a grace period) would
    # otherwise pin the simulator lease for the whole budget after the build
    # already finished.
    if [ -n "$AAX_LOG" ]; then
        "$@" 8>&- 9>&- > >(tee -a "$AAX_LOG") 2> >(tee -a "$AAX_LOG" >&2) &
    else
        "$@" 8>&- 9>&- &
    fi
    cmd_pid=$!
    (
        sleep "$budget"
        # Record the fact of firing: liveness of the watchdog itself cannot be
        # used as the signal, because it stays alive through the grace period.
        kill -TERM "$cmd_pid" 2>/dev/null && printf 1 > "$marker"
        sleep 10
        kill -KILL "$cmd_pid" 2>/dev/null
    ) 8>&- 9>&- &
    dog_pid=$!

    # Braces + redirect suppress bash's asynchronous "Terminated: 15" job
    # notice, which would otherwise be mistaken for tool output.
    { wait "$cmd_pid"; rc=$?; } 2>/dev/null
    kill "$dog_pid" 2>/dev/null
    { wait "$dog_pid"; } 2>/dev/null
    [ -s "$marker" ] && AAX_TIMED_OUT=1
    rm -f "$marker"
    return $rc
}

# Run once, classify the failure, and retry exactly once if the environment —
# not the code — was what broke. A genuine test or compile failure is returned
# on the first attempt, preserving its exit status.
#
# Set by the last call: AAX_FAILURE_CLASS, AAX_RETRIED.
AAX_FAILURE_CLASS="" AAX_RETRIED=0

aax_attempt() {
    local budget="$1"; shift
    local rc attempt_log

    AAX_FAILURE_CLASS="" AAX_RETRIED=0
    attempt_log=$(mktemp -t ai-aligned-xcode-log) || { aax_run "$budget" "$@"; return $?; }
    AAX_LOG="$attempt_log"

    aax_run "$budget" "$@"
    rc=$?

    if [ "$rc" -ne 0 ] && [ "$AAX_TIMED_OUT" != "1" ]; then
        AAX_FAILURE_CLASS=$(aax_classify "$attempt_log")
        if [ "${AI_ALIGNED_XCODE_NO_RETRY:-false}" != "true" ] \
           && aax_is_retryable "$AAX_FAILURE_CLASS"; then
            aax_notice "$AAX_FAILURE_CLASS: the simulator environment failed before your code ran; retrying once"

            # A wedged device is the common cause, and we hold its lease, so
            # bouncing it is safe. shutdown only — erase would destroy app state
            # the caller may be relying on.
            if [ "$AAX_FAILURE_CLASS" = "sim_boot" ] || [ "$AAX_FAILURE_CLASS" = "coresim" ]; then
                if [ -n "$AAX_UDID" ]; then
                    aax_notice "shutting down $AAX_UDID before the retry"
                    AI_ALIGNED_XCODE_ACTIVE=1 /usr/bin/xcrun simctl shutdown "$AAX_UDID" >/dev/null 2>&1
                fi
            fi

            : > "$attempt_log"
            AAX_RETRIED=1
            aax_run "$budget" "$@"
            rc=$?
            [ "$rc" -ne 0 ] && AAX_FAILURE_CLASS=$(aax_classify "$attempt_log")
        fi
    fi

    AAX_LOG=""
    rm -f "$attempt_log"
    return "$rc"
}

# ---------------------------------------------------------------- the gate

# Quote an argv back into something the caller can paste verbatim.
aax_quote_cmd() {
    local out="" a
    for a in "$@"; do
        case "$a" in
            *[![:alnum:]_/.=:-]*) out="$out '${a//\'/\'\\\'\'}'" ;;
            *) out="$out $a" ;;
        esac
    done
    printf '%s' "${out# }"
}

# Refuse a run the caller has not budgeted for. Returns 1 to abort.
# Echoes back the caller's ORIGINAL argv, not our rewritten one — they should
# re-run their own command, not ours.
aax_check_budget() {
    local gkey="$1" tool="$2"; shift 2
    local median

    if [ -n "$TIMEOUT" ]; then
        return 0
    fi

    median=$(aax_predict "$gkey")
    [ -z "$median" ] && return 0
    [ "$median" -le $((AAX_BUDGET * 1000)) ] && return 0

    local med_s=$((median / 1000)) suggest=$(( (median / 1000) * 2 ))
    local orig; orig=$(aax_quote_cmd "$tool" "$@")
    cat >&2 <<EOF
ai-aligned-xcode: refusing to start an unbudgeted long run.

  command   : $tool $AAX_ACTION${AAX_SCHEME:+ -scheme $AAX_SCHEME}
  predicted : ~${med_s}s (median of recent runs for this scheme/action/destination)
  budget    : ${AAX_BUDGET}s

This run will most likely outlive your harness's command timeout, and you will
lose the output rather than the work. Re-run with an explicit budget so you know
what you are signing up for:

  TIMEOUT=${suggest} ${orig}

TIMEOUT is in seconds. The run is killed if it exceeds it, and you get partial
output plus a clear timeout status instead of a silent truncation.
EOF
    return 1
}

# ---------------------------------------------------------------- xcodebuild shim

aax_shim_xcodebuild() {
    local real agent repo worktree gkey lease_file
    local start end dur wait_ms=0 rc outcome

    real=$(aax_real_tool xcodebuild) || { echo "ai-aligned-xcode: cannot find real xcodebuild" >&2; exit 127; }

    # Read-only queries are fast and touch nothing. They must stay pristine —
    # callers parse their stdout.
    local a
    for a in "$@"; do
        case "$a" in
            -version|-usage|-help|-list|-showsdks|-showdestinations|\
            -showTestPlans|-checkFirstLaunchStatus)
                exec "$real" "$@" ;;
        esac
    done

    aax_parse_xcodebuild "$@"
    aax_resolve_destination "$AAX_DEST"

    repo=$(aax_repo_root)
    worktree=$(aax_worktree_slug "$repo")
    agent=$(aax_agent)
    # A monorepo can hold several .xcodeproj, so the project is part of the key.
    gkey="$(basename "$repo")|$(basename "${AAX_PROJECT:-.}")|xcodebuild|$AAX_ACTION|$AAX_SCHEME|$AAX_DEST_KIND"

    # (3) Budget gate runs first, so a refused run emits one clear reason
    # instead of a rewrite notice followed by a refusal. The schema must exist
    # before the predictor queries it.
    aax_db_init

    # (0) Ownership. Before anything expensive: a device belonging to another
    # worktree is refused outright, with this worktree's equivalent named in
    # the message. Catches the 65% of sessions that arrive with a UDID copied
    # from memory or a compaction summary and never run `simctl list`.
    if [ "$AAX_DEST_KIND" = "sim" ] && [ -n "$AAX_UDID" ]; then
        aax_check_ownership "$AAX_UDID" "$(aax_worktree_label "$repo")" || exit 78
    fi

    aax_check_budget "$gkey" xcodebuild "$@" || exit 78

    local -a argv=("$@")
    local dd_effective="$AAX_DDP"

    # (2) Per-worktree DerivedData. 894 of 1153 observed xcodebuild calls omitted
    # this, so parallel checkouts collided in the default location.
    if [ -z "$AAX_DDP" ] && [ "$AAX_ACTION" != "clean" ]; then
        dd_effective="$AAX_DD/$(basename "$repo")-$worktree"
        mkdir -p "$dd_effective" 2>/dev/null
        argv+=(-derivedDataPath "$dd_effective")
        aax_notice "using per-worktree DerivedData: $dd_effective"
    fi

    local budget=0
    [ -n "$TIMEOUT" ] && budget="$TIMEOUT"

    export AI_ALIGNED_XCODE_ACTIVE=1
    mkdir -p "$AAX_LEASES" 2>/dev/null

    # Leases, in the one permitted order: DerivedData (fd 8) then simulator
    # (fd 9). See "lock ordering". aax_take_lease sets AAX_LEASE_FAILED and
    # accumulates AAX_LEASE_WAIT_MS.
    AAX_LEASE_WAIT_MS=0
    if [ "$AAX_NO_LEASE" = "0" ] && [ "$AAX_ACTION" != "clean" ] && [ -n "$dd_effective" ]; then
        aax_take_lease 8 "$(aax_dd_lock_file "$dd_effective")" \
            "another build is writing $dd_effective"
    fi
    if [ "$AAX_LEASE_FAILED" = "0" ] && [ "$AAX_NO_LEASE" = "0" ] \
       && [ "$AAX_DEST_KIND" = "sim" ] && [ -n "$AAX_UDID" ]; then
        aax_take_lease 9 "$AAX_LEASES/$AAX_UDID.lock" \
            "simulator $AAX_UDID is leased by another run"
    fi
    wait_ms="$AAX_LEASE_WAIT_MS"

    if [ "$AAX_LEASE_FAILED" = "1" ]; then
        outcome="lease_timeout"; rc=75
        # Nothing ran, so there is no run to time. Without this, `start` stays
        # unset and `end - start` records the epoch as a duration, which reads
        # as a 56-year build in `stats`.
        start=$(date +%s000)
    else
        start=$(date +%s000)     # time the run, not the wait
        aax_attempt "$budget" "$real" "${argv[@]}"
        rc=$?
    fi
    exec 8>&- 9>&- 2>/dev/null

    end=$(date +%s000); dur=$((end - start))
    if [ -z "$outcome" ]; then
        if [ "$AAX_TIMED_OUT" = "1" ]; then
            outcome="timeout"
            aax_notice "killed after ${budget}s (TIMEOUT budget reached)"
        elif [ "$rc" -eq 0 ]; then outcome="ok"
        else outcome="fail"
        fi
    fi

    aax_record "$agent" "$(basename "$repo")" "$worktree" xcodebuild "$AAX_ACTION" \
               "$AAX_SCHEME" "$AAX_DEST_KIND" "$AAX_UDID" "$gkey" \
               "$dur" "$wait_ms" "$rc" "$outcome"
    exit "$rc"
}

# ---------------------------------------------------------------- xcrun shim

# simctl subcommands that mutate device state and therefore need the lease.
AAX_SIMCTL_MUTATING=" boot shutdown erase install uninstall launch terminate openurl privacy keychain "

aax_shim_xcrun() {
    local real="/usr/bin/xcrun"

    # Fast path: anything that is not a state-mutating simctl call passes
    # straight through. xcrun is called ~1140 times in the corpus, mostly for
    # trivial lookups.
    if [ "$1" != "simctl" ]; then
        exec "$real" "$@"
    fi

    local sub="$2" udid="$3"

    # `simctl create <name> <type> <runtime>` — stamp the worktree into the
    # name so a hand-made device is owned from birth. Rare (3 calls in the
    # whole corpus) but it is the one place an agent names a device itself,
    # and an untagged new device would otherwise be claimed by whoever
    # touches it next.
    if [ "$sub" = "create" ] && [ -n "$3" ]; then
        local label; label=$(aax_worktree_label "$(aax_repo_root)")
        case "$3" in
            *" [$label]") ;;                       # already tagged
            *"["*"]")     ;;                       # tagged for someone else: leave it, ownership will catch it
            *) aax_notice "tagging new device as '$3 [$label]'"
               set -- "$1" "$2" "$3 [$label]" "${@:4}" ;;
        esac
        exec "$real" "$@"
    fi

    case "$AAX_SIMCTL_MUTATING" in
        *" $sub "*) ;;
        *) exec "$real" "$@" ;;
    esac

    # simctl takes the UDID (or "booted"/"all") as the first operand.
    case "$udid" in
        [0-9A-Fa-f]*-*) ;;
        *) exec "$real" "$@" ;;
    esac

    aax_db_init
    local agent repo start dur rc lease_file
    agent=$(aax_agent); repo=$(aax_repo_root)

    # Same ownership rule as xcodebuild: booting, installing into or erasing
    # another worktree's device is exactly the interference this prevents.
    aax_check_ownership "$udid" "$(aax_worktree_label "$repo")" || exit 78

    mkdir -p "$AAX_LEASES" 2>/dev/null
    lease_file="$AAX_LEASES/$udid.lock"

    export AI_ALIGNED_XCODE_ACTIVE=1
    start=$(date +%s000)
    AAX_LEASE_FAILED=0
    aax_take_lease 9 "$lease_file" "simulator $udid is leased by another run"
    if [ "$AAX_LEASE_FAILED" = "1" ]; then
        exec 9>&- 2>/dev/null
        exit 75
    fi
    "$real" "$@" 9>&-
    rc=$?
    exec 9>&- 2>/dev/null
    dur=$(( $(date +%s000) - start ))

    aax_record "$agent" "$(basename "$repo")" "$(aax_worktree_slug "$repo")" \
               simctl "$sub" "" sim "$udid" \
               "$(basename "$repo")|simctl|$sub||sim" \
               "$dur" 0 "$rc" "$([ "$rc" -eq 0 ] && echo ok || echo fail)"
    exit "$rc"
}

# ---------------------------------------------------------------- swift / xcodegen

# Neither touches a simulator, so they take no lease. They are recorded because
# the predictor needs their history too.
aax_shim_recorded() {
    local tool="$1"; shift
    local real agent repo gkey start dur rc action="${1:-run}"

    real=$(aax_real_tool "$tool") || { echo "ai-aligned-xcode: cannot find real $tool" >&2; exit 127; }
    aax_db_init
    agent=$(aax_agent); repo=$(aax_repo_root)
    gkey="$(basename "$repo")|.|$tool|$action||none"

    AAX_ACTION="$action"
    aax_check_budget "$gkey" "$tool" "$@" || exit 78

    local budget=0
    [ -n "$TIMEOUT" ] && budget="$TIMEOUT"

    export AI_ALIGNED_XCODE_ACTIVE=1

    # xcodegen rewrites the .xcodeproj a build is reading, so it takes the same
    # worktree's DerivedData lease (fd 8, and only fd 8 — no cycle possible).
    # Rare in practice, but an agent was observed polling `pgrep -f xcodegen`
    # to hand-roll exactly this.
    AAX_LEASE_FAILED=0
    if [ "$tool" = "xcodegen" ]; then
        mkdir -p "$AAX_LEASES" 2>/dev/null
        aax_take_lease 8 \
            "$(aax_dd_lock_file "$AAX_DD/$(basename "$repo")-$(aax_worktree_slug "$repo")")" \
            "a build is using this worktree's DerivedData"
    fi
    if [ "$AAX_LEASE_FAILED" = "1" ]; then
        aax_record "$agent" "$(basename "$repo")" "$(aax_worktree_slug "$repo")" \
                   "$tool" "$action" "" none "" "$gkey" 0 0 75 lease_timeout
        exit 75
    fi

    start=$(date +%s000)
    # Classified too: `swift build` can lose to a concurrent build-database lock
    # just as xcodebuild can, and that is worth one retry.
    aax_attempt "$budget" "$real" "$@"
    rc=$?
    dur=$(( $(date +%s000) - start ))
    exec 8>&- 2>/dev/null

    local outcome=ok
    [ "$AAX_TIMED_OUT" = "1" ] && outcome=timeout
    [ "$rc" -ne 0 ] && [ "$outcome" = "ok" ] && outcome=fail

    aax_record "$agent" "$(basename "$repo")" "$(aax_worktree_slug "$repo")" \
               "$tool" "$action" "" none "" "$gkey" "$dur" 0 "$rc" "$outcome"
    exit "$rc"
}

# ---------------------------------------------------------------- reporting CLI

aax_cli() {
    case "${1:-help}" in
        stats)
            aax_db_init
            # Keys are printed whole: the distinguishing part (action, scheme,
            # destination) is the tail, so truncating the head makes distinct
            # rows look identical.
            aax_sql -header -column "
WITH ranked AS (
  SELECT gkey, duration_ms, outcome,
         ROW_NUMBER() OVER (PARTITION BY gkey ORDER BY duration_ms) rn,
         COUNT(*)     OVER (PARTITION BY gkey)                      n
    FROM runs WHERE duration_ms IS NOT NULL)
SELECT gkey AS key, n,
       MAX(CASE WHEN rn=(n+1)/2           THEN duration_ms/1000 END)||'s' AS median,
       MAX(CASE WHEN rn=MAX(1,(n*9+9)/10) THEN duration_ms/1000 END)||'s' AS p90,
       SUM(CASE WHEN outcome<>'ok' THEN 1 ELSE 0 END)                     AS fails
  FROM ranked GROUP BY gkey, n ORDER BY n DESC;"
            ;;
        failures)
            aax_db_init
            aax_sql -header -column "
SELECT COALESCE(NULLIF(failure_class,''),'(unclassified)') AS class,
       COUNT(*)                                           AS n,
       SUM(retried)                                       AS retried,
       CASE WHEN COALESCE(NULLIF(failure_class,''),'x') IN
                 ('runner_bootstrap','sim_boot','runner_crash','coresim','build_db_lock')
            THEN 'infrastructure' ELSE 'your code' END    AS kind
  FROM runs
 WHERE outcome <> 'ok'
 GROUP BY class ORDER BY n DESC;"
            ;;
        devices)
            aax_db_init
            local me; me=$(aax_worktree_label "$(aax_repo_root)")
            echo "worktree: $me"
            echo
            AI_ALIGNED_XCODE_ACTIVE=1 /usr/bin/xcrun simctl list devices --json 2>/dev/null \
              | jq -r --arg me "$me" '
                  .devices | to_entries[] | .key as $rt | .value[]
                  | select(.isAvailable)
                  # capture/2 emits NOTHING on no-match, which silently drops
                  # every untagged device. Branch on test/1 instead.
                  | (.name | test(" \\[[^]]+\\]$")) as $tagged
                  | (if $tagged then (.name | sub(" \\[[^]]+\\]$"; "")) else .name end) as $base
                  | (if $tagged then (.name | capture(" \\[(?<o>[^]]+)\\]$").o) else "" end) as $own
                  | [ (if $own == "" then "-" elif $own == $me then "MINE" else $own end),
                      $base, .udid, .state,
                      ($rt | sub("com.apple.CoreSimulator.SimRuntime.";"")) ]
                  | @tsv' 2>/dev/null \
              | sort | awk -F'\t' 'BEGIN{printf "%-16s %-26s %-38s %-9s %s\n","OWNER","DEVICE","UDID","STATE","RUNTIME"}
                                   {printf "%-16s %-26s %-38s %-9s %s\n",$1,$2,$3,$4,$5}'
            ;;
        release)
            # Undo ownership on devices we only borrowed, restoring the stock
            # name. Assignment renames real devices the user may also use by
            # hand, so this has to be a one-liner to reverse.
            aax_db_init
            echo "stock devices to untag (cloned ones are left to 'reap'):"
            local rn=0
            while IFS='|' read -r u b; do
                [ -z "$u" ] && continue
                echo "  $u -> \"$b\""
                # $1 is still the subcommand here; the flag is $2.
                if [ "${2:-}" = "--apply" ]; then
                    AI_ALIGNED_XCODE_ACTIVE=1 /usr/bin/xcrun simctl rename "$u" "$b" 2>/dev/null \
                        && aax_sql "DELETE FROM devices WHERE udid='${u//\'/\'\'}';" \
                        && echo "    restored"
                fi
                rn=$((rn+1))
            done <<EOF
$(aax_sql "SELECT udid||'|'||base_name FROM devices WHERE created_by_aax=0;")
EOF
            [ "$rn" -eq 0 ] && echo "  (none)"
            [ "${2:-}" != "--apply" ] && [ "$rn" -gt 0 ] && echo "  (dry run — pass --apply to restore)"
            ;;
        reap)
            aax_db_init
            shift
            local apply=0 older="" include_never=0 orphaned=0 arg
            while [ $# -gt 0 ]; do
                arg="$1"
                case "$arg" in
                    --apply)              apply=1 ;;
                    --older-than)         older="$2"; shift ;;
                    --older-than=*)       older="${arg#*=}" ;;
                    --include-never-used) include_never=1 ;;
                    --orphaned)           orphaned=1 ;;
                    *) echo "reap: unknown option '$arg'" >&2; return 1 ;;
                esac
                shift
            done

            local cutoff=0
            if [ -n "$older" ]; then
                cutoff=$(aax_duration_seconds "$older") \
                    || { echo "reap: cannot parse duration '$older' (try 3d, 12h, 90m)" >&2; return 1; }
            fi

            # One JSON fetch, shared by selection and reporting. mktemp rather
            # than a fixed path: concurrent agents run this too.
            local devjson; devjson=$(mktemp -t aax-devs) || return 1
            AI_ALIGNED_XCODE_ACTIVE=1 /usr/bin/xcrun simctl list devices --json \
                >"$devjson" 2>/dev/null

            # Selection lives in python — it needs lastUsedAt arithmetic and
            # byte sizes in one pass. Emits every non-booted available device
            # as: udid, name, size, age, owner-tag, matches-age-criteria.
            # Orphan filtering happens in bash below, because deciding whether
            # a worktree still exists needs the filesystem and the database.
            local cands
            cands=$(AAX_CUTOFF="$cutoff" AAX_NEVER="$include_never" AAX_MINE="$(aax_sql \
                    "SELECT group_concat(udid,' ') FROM devices WHERE created_by_aax=1;")" \
                python3 -c '
import json, os, re, sys, time
from datetime import datetime, timezone

cutoff = int(os.environ["AAX_CUTOFF"])
want_never = os.environ["AAX_NEVER"] == "1"
mine = set((os.environ.get("AAX_MINE") or "").split())
now = time.time()

for rt, devs in json.load(open(sys.argv[1]))["devices"].items():
    for d in devs:
        if not d.get("isAvailable"):
            continue
        # A booted device is in use by definition. Never a candidate.
        if d.get("state") == "Booted":
            continue
        last, age, matches = d.get("lastUsedAt"), None, False
        if last:
            t = datetime.strptime(last, "%Y-%m-%dT%H:%M:%SZ").replace(
                tzinfo=timezone.utc).timestamp()
            age = (now - t) / 86400.0
        if cutoff:
            if last is None:
                # Never-used devices are pristine stock at ~20MB. They are the
                # supply assignment draws from, not waste; deleting them frees
                # nothing and forces a create for the next worktree.
                matches = want_never
            else:
                matches = (now - t) >= cutoff
        else:
            matches = d["udid"] in mine
        m = re.search(r" \[([^]]+)\]$", d["name"])
        # "-" rather than "": TAB is IFS whitespace, so bash read collapses
        # runs of tabs and an empty field would silently shift every later
        # column left — which made untagged devices look orphaned.
        print("\t".join([d["udid"], d["name"], str(d.get("dataPathSize") or 0),
                         ("%.1f" % age) if age is not None else "never",
                         m.group(1) if m else "-", "1" if matches else "0"]))
' "$devjson" 2>/dev/null)

            # --orphaned selects by owner rather than age. That is the point:
            # with agents this busy almost nothing gets old enough for an age
            # filter to catch, while a device abandoned an hour ago by a
            # deleted worktree is already dead weight.
            if [ "$orphaned" = "1" ]; then
                echo "devices whose owning worktree no longer exists:"
            elif [ -n "$older" ]; then
                echo "devices not used in the last $older:"
            else
                echo "devices this tool created:"
            fi

            local n=0 freed=0 u nm sz age owner match skipped=0 why wtp
            while IFS=$'\t' read -r u nm sz age owner match; do
                [ -z "$u" ] && continue

                if [ "$orphaned" = "1" ]; then
                    # Untagged devices have no owner and cannot be orphaned.
                    { [ -z "$owner" ] || [ "$owner" = "-" ]; } && continue
                    wtp=$(aax_sql "SELECT COALESCE(worktree_path,'') FROM devices
                                   WHERE udid='${u//\'/\'\'}';")
                    aax_worktree_exists "$owner" "$wtp" >/dev/null && continue
                    why="owner gone"
                else
                    [ "$match" = "1" ] || continue
                    why="$([ "$age" = "never" ] && echo never || echo "${age}d ago")"
                fi

                # Two live-use guards the JSON cannot answer.
                if aax_lease_held "$AAX_LEASES/$u.lock"; then
                    echo "  skip  $nm ($u) — lease currently held"
                    skipped=$((skipped + 1)); continue
                fi
                if pgrep -fl 'xcodebuild|xctest' 2>/dev/null | grep -q "$u"; then
                    echo "  skip  $nm ($u) — a running build references it"
                    skipped=$((skipped + 1)); continue
                fi
                printf '  %-34s %6.2f GB  %-12s %s\n' "${nm:0:34}" \
                    "$(echo "$sz" | awk '{print $1/1073741824}')" "$why" "$u"
                n=$((n + 1)); freed=$((freed + sz))
                if [ "$apply" = "1" ]; then
                    if AI_ALIGNED_XCODE_ACTIVE=1 /usr/bin/xcrun simctl delete "$u" >/dev/null 2>&1; then
                        aax_sql "DELETE FROM devices WHERE udid='${u//\'/\'\'}';"
                        rm -f "$AAX_LEASES/$u.lock"
                        echo "        deleted"
                    else
                        echo "        DELETE FAILED"
                    fi
                fi
            done <<< "$cands"
            rm -f "$devjson"

            [ "$n" -eq 0 ] && echo "  (none)"
            [ "$skipped" -gt 0 ] && echo "  ($skipped skipped as in use)"
            if [ "$n" -gt 0 ]; then
                echo "  ---"
                printf '  %d device(s), %.2f GB%s\n' "$n" \
                    "$(echo "$freed" | awk '{print $1/1073741824}')" \
                    "$([ "$apply" = "1" ] && echo ' freed' || echo ' would be freed')"
                [ "$apply" = "1" ] || echo "  (dry run — pass --apply to delete)"
            fi
            ;;
        leases)
            echo "held simulator leases:"
            for f in "$AAX_LEASES"/*.lock; do
                [ -e "$f" ] || { echo "  (none)"; break; }
                if ! aax_lease_held "$f"; then
                    echo "  $(basename "$f" .lock)  free"
                else
                    echo "  $(basename "$f" .lock)  HELD"
                fi
            done
            ;;
        doctor)
            echo "ai-aligned-xcode $VERSION"
            echo "  state dir     : $AAX_HOME"
            echo "  detected as   : $(aax_agent)"
            echo "  real xcodebuild: $(aax_real_tool xcodebuild)"
            echo "  python3       : $(command -v python3 >/dev/null && echo "ok ($(python3 -c 'import fcntl; print("fcntl available")' 2>/dev/null || echo 'NO fcntl'))" || echo 'MISSING (leases will not work)')"
            echo "  sqlite3       : $(/usr/bin/sqlite3 --version 2>/dev/null | cut -d' ' -f1)"
            echo "  jq            : $(command -v jq >/dev/null && echo ok || echo 'missing (name= destinations will not resolve)')"
            echo "  runs recorded : $(aax_sql 'SELECT COUNT(*) FROM runs;' 2>/dev/null || echo 0)"
            ;;
        version) echo "ai-aligned-xcode $VERSION" ;;
        *)
            cat <<EOF
ai-aligned-xcode $VERSION

Transparent Xcode toolchain shim for coding agents. Installed as xcodebuild,
xcrun, swift and xcodegen earlier on PATH; there is nothing to teach the agent.

  ai-aligned-xcode stats     per-key runtime history feeding the predictor
  ai-aligned-xcode failures  failure classes, and which were infrastructure
  ai-aligned-xcode devices   simulator ownership, by worktree
  ai-aligned-xcode leases    which simulators are currently leased
  ai-aligned-xcode release   untag borrowed stock devices, restoring names (--apply)
  ai-aligned-xcode reap      delete devices this tool created (--apply)
    reap --orphaned            ...or devices whose worktree is gone
    reap --older-than 3d       ...or any device unused for that long
    reap --include-never-used  ...also never-booted stock devices (rarely wanted)
  ai-aligned-xcode doctor    environment check
  ai-aligned-xcode version

Environment:
  TIMEOUT=<seconds>                  budget for this run (bypasses the gate)
  AI_ALIGNED_XCODE_DISABLE=true      pass everything through untouched
  AI_ALIGNED_XCODE_BUDGET=<seconds>  gate threshold (default 300)
  AI_ALIGNED_XCODE_NO_RETRY=true     never retry infrastructure failures
  AI_ALIGNED_XCODE_NO_OWNERSHIP=true skip the device-ownership check
  AI_ALIGNED_XCODE_DEBUG=true        trace decisions to stderr
EOF
            ;;
    esac
}

# ---------------------------------------------------------------- entry point

INVOKED_AS="$(basename "$0")"
# Running the file in place, before chezmoi/install.sh strips the prefix.
INVOKED_AS="${INVOKED_AS#executable_}"

# Re-entrancy guard. xcodebuild resolves its own toolchain by absolute path so
# this rarely fires, but a build that does shell out must not re-enter the shim.
if [ -n "$AI_ALIGNED_XCODE_ACTIVE" ] || [ "$AAX_DISABLE" = "true" ]; then
    case "$INVOKED_AS" in
        ai-aligned-xcode) aax_cli "$@"; exit $? ;;
        *) real=$(aax_real_tool "$INVOKED_AS") && exec "$real" "$@"
           echo "ai-aligned-xcode: cannot find real $INVOKED_AS" >&2; exit 127 ;;
    esac
fi

# Humans get an untouched tool.
if [ "$INVOKED_AS" != "ai-aligned-xcode" ] && [ "$(aax_agent)" = "none" ]; then
    aax_debug "no agent detected, passing through"
    real=$(aax_real_tool "$INVOKED_AS") && exec "$real" "$@"
    echo "ai-aligned-xcode: cannot find real $INVOKED_AS" >&2; exit 127
fi

case "$INVOKED_AS" in
    xcodebuild)       aax_shim_xcodebuild "$@" ;;
    xcrun)            aax_shim_xcrun "$@" ;;
    swift)            aax_shim_recorded swift "$@" ;;
    xcodegen)         aax_shim_recorded xcodegen "$@" ;;
    ai-aligned-xcode) aax_cli "$@" ;;
    *)
        real=$(aax_real_tool "$INVOKED_AS") && exec "$real" "$@"
        echo "ai-aligned-xcode: unknown invocation '$INVOKED_AS'" >&2; exit 127 ;;
esac
