#!/bin/bash
#
# ai-aligned-xcode - transparent Xcode toolchain shim for coding agents
#
# Installed as xcodebuild / xcrun / swift / xcodegen earlier on PATH than the
# real tools. Dispatches on $0. When the caller is a coding agent it:
#
#   1. Takes an exclusive lease on the destination simulator (UDID-keyed), so
#      parallel agents serialise on the device instead of colliding on it.
#   2. Injects a per-worktree -derivedDataPath so parallel checkouts stop
#      sharing one DerivedData.
#   3. Predicts the runtime from recorded history and refuses invocations whose
#      median exceeds the budget unless the caller sets TIMEOUT, so an agent
#      never unknowingly signs up for a run its harness will kill.
#   4. Records every run in SQLite to feed (3).
#
# Humans get an untouched pass-through.
#
# See: https://github.com/ai-ecoverse/ai-aligned-xcode

VERSION="0.1.0"

# ---------------------------------------------------------------- configuration

AAX_HOME="${AI_ALIGNED_XCODE_HOME:-$HOME/.ai-aligned-xcode}"
AAX_DB="$AAX_HOME/runs.db"
AAX_LEASES="$AAX_HOME/leases"
AAX_DD="$AAX_HOME/derived"
AAX_CACHE="$AAX_HOME/cache"

# Refuse a run whose predicted median exceeds this (seconds) unless TIMEOUT is set.
AAX_BUDGET="${AI_ALIGNED_XCODE_BUDGET:-300}"
# How long to wait for a simulator lease before giving up (seconds).
AAX_LEASE_WAIT="${AI_ALIGNED_XCODE_LEASE_WAIT:-1800}"
# Minimum samples before the predictor is trusted.
AAX_MIN_SAMPLES="${AI_ALIGNED_XCODE_MIN_SAMPLES:-3}"
# Set to "true" to pass everything through untouched.
AAX_DISABLE="${AI_ALIGNED_XCODE_DISABLE:-false}"

DEBUG="${AI_ALIGNED_XCODE_DEBUG:-false}"

aax_debug() {
    [ "$DEBUG" = "true" ] && echo "[ai-aligned-xcode] $*" >&2
    return 0
}

# Corrective notices go to stderr so they land in the agent's tool output
# without polluting stdout, which callers parse.
aax_notice() {
    echo "ai-aligned-xcode: $*" >&2
}

# am-i-ai's bundler deliberately strips _ami_debug ("we use debug_log instead"),
# so the consuming script must supply it. Without this the bundled detection
# emits 73 "command not found" lines onto the wrapped tool's stderr.
_ami_debug() {
    [ "${AMI_DEBUG:-}" = "true" ] && echo "[am-i-ai] $*" >&2
    return 0
}

